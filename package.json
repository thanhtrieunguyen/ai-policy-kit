{
  "name": "ai-policy-kit",
  "version": "1.0.0",
  "description": "Standardized, machine-actionable AI contribution policy validator, CLI tooling, and GitHub Action",
  "keywords": [
    "ai-policy",
    "ai-governance",
    "compliance",
    "cli",
    "github-action",
    "json-schema",
    "pull-request",
    "policy-validation"
  ],
  "homepage": "https://github.com/thanhtrieunguyen/ai-policy-kit#readme",
  "bugs": {
    "url": "https://github.com/thanhtrieunguyen/ai-policy-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thanhtrieunguyen/ai-policy-kit.git"
  },
  "license": "MIT",
  "author": "Thanh Trieu Nguyen <https://github.com/thanhtrieunguyen>",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ai-policy": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./presets/*": "./presets/*",
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "presets",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "action.yml"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@changesets/cli": "^2.27.1",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.0.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
